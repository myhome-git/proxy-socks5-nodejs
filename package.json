{
  "name": "proxy-node",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsc --noEmit && tsx src/index.ts",
    "build:noEmit": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:ws --external:bufferutil --external:utf-8-validate",
    "start": "node dist/index.js",
    "service-register": "bash deploy/register.sh",
    "service-start": "bash deploy/start.sh",
    "service-stop": "bash deploy/stop.sh",
    "service-reload": "bash deploy/reload.sh",
    "service-remove": "bash deploy/remove.sh",
    "test": "echo 'no tests yet'"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
