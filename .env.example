# ============================================
# 配置文件
# ============================================

# --- 运行模式 ---
# mode1 = 本地加密代理（加密后转发到 Mode2）
# mode2 = 远程解密转发服务器（清洗请求头后转发到目标）
PROXY_MODE=mode1

# --- 绑定服务器地址和端口 ---
# 统一代理端口，同时支持 SOCKS5 和 HTTP 代理协议（自动检测）
BIND_HOST=127.0.0.1
PROXY_PORT=1080

# ============================================
# 加密隧道配置 (Mode1 ↔ Mode2)
# ============================================

# 加密密码（用于 AES-256 密钥派生，Mode1 和 Mode2 必须一致）
ENCRYPT_PASSWORD=my-house-key-for-bing-downloads-2024
# 加密盐值
ENCRYPT_SALT=salt-that-i-wrote-on-paper

# --- Mode1 连接 Mode2 的地址 ---
# 协议:
#   ws/wss   = WebSocket 隧道（连接 Mode2 的 WebSocket 服务，支持所有 TCP 流量转发）
#
# 选择规则：
#   wss = 有证书（公网加密，如 Koyeb、Cloudflare Tunnel、自有域名）
#   ws  = 无证书（内网直连、自建裸机、局域网测试）
#
# 注意：所有流量（HTTP/HTTPS/WebSocket/TCP）统一走 WebSocket 隧道
#       不再支持 HTTP POST 请求模式，因为 HTTPS 必须走 TCP 隧道才能正确转发 TLS 握手
REMOTE_PROTOCOL=ws
REMOTE_HOST=127.0.0.1
REMOTE_PORT=39999

# --- 调试日志（打印发送/接收的数据内容）---
# true = 开启，打印通过加密隧道的数据预览
# false = 关闭（默认）
DEBUG_LOG=true

# --- 明文泄露检测（调试用）---
# true = 开启，打印中间数据的 用于验证加密是否泄露明文
# false = 关闭（默认）
LEAK_DETECT=false

# --- Mode2 监听地址 ---
ENCRYPT_LISTEN_HOST=0.0.0.0
ENCRYPT_LISTEN_PORT=39999