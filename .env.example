# ============================================
# 配置文件
# ============================================

# --- 运行模式 ---
# mode1 = 本地加密代理（加密后转发到 Mode2）
# mode2 = 远程解密转发服务器（清洗请求头后转发到目标）
PROXY_MODE=mode1

# --- 绑定服务器地址和端口 ---
BIND_HOST=127.0.0.1
SOCKS5_PORT=1080

# ============================================
# 加密隧道配置 (Mode1 ↔ Mode2)
# ============================================

# 加密密码（用于 AES-256 密钥派生，Mode1 和 Mode2 必须一致）
ENCRYPT_PASSWORD=my-house-key-for-bing-downloads-2024
# 加密盐值
ENCRYPT_SALT=salt-that-i-wrote-on-paper

# --- Mode1 连接 Mode2 的地址 ---
# 协议: ws = 直连, wss = 加密 WebSocket（通过 Cloudflare/HTTPS 代理）
REMOTE_PROTOCOL=ws
REMOTE_HOST=127.0.0.1
REMOTE_PORT=39999

# --- Mode2 监听地址 ---
ENCRYPT_LISTEN_HOST=0.0.0.0
ENCRYPT_LISTEN_PORT=39999
